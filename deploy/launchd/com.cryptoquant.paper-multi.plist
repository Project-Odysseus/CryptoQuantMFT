<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The multi-strategy book in PAPER mode (no orders, no keys used) as a macOS LaunchAgent: five trend sleeves on BTC, ETH
  and SOL plus the 40-coin taker basket, at 10,000 USD of pretend capital (config/portfolio.multi_paper.toml). It
  decides once a day, polls every 5 minutes, fetches Binance's public daily candles once a day for the basket, is
  restarted if it exits, and keeps the Mac from idle-sleeping while it runs. Runs next to com.cryptoquant.paper.
    install:  cp deploy/launchd/com.cryptoquant.paper-multi.plist ~/Library/LaunchAgents/
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cryptoquant.paper-multi.plist
    status:   python main.py --portfolio config/portfolio.multi_paper.toml --dashboard
    remove:   launchctl bootout gui/$(id -u)/com.cryptoquant.paper-multi && rm ~/Library/LaunchAgents/com.cryptoquant.paper-multi.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cryptoquant.paper-multi</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/Users/Sakarias/anaconda3/envs/CryptoArb/bin/python</string>
    <string>main.py</string>
    <string>--runtime</string><string>paper</string>
    <string>--portfolio</string><string>config/portfolio.multi_paper.toml</string>
    <string>--portfolio-state-dir</string><string>data/portfolio/multi-paper</string>
    <string>--runtime-iterations</string><string>0</string>
    <string>--runtime-interval</string><string>300</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/Sakarias/Odysseus/QuantMultiStrat</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/Sakarias/anaconda3/envs/CryptoArb/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/Sakarias/Odysseus/QuantMultiStrat/logs/paper-multi/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/Sakarias/Odysseus/QuantMultiStrat/logs/paper-multi/launchd.err.log</string>
</dict>
</plist>
