[Unit]
Description=CryptoQuant research collector: Binance + Bybit liquidations (public data, no keys)
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ main.py --record-market-data --record-config config/market_data.liquidations.json
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
