[Unit]
Description=CryptoQuant research collector: Kraken Futures spreads and book depth (public data, no keys)
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ scripts/collectors/kraken_spreads.py config/portfolio.multi_paper.toml
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
