[Unit]
Description=CryptoQuant research collector: prediction-market quotes and order books, Kalshi and Polymarket (public data, no keys)
Wants=network-online.target
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ scripts/collectors/prediction_books.py
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
